Algoritmo ejercicioItiid102
	
	Definir valor1, valor2, suma, producto, div Como Real;
	
	//Datos de entrada
	Escribir "Ingresa el valor 1: ";
	Leer valor1;
	Escribir "Ingresa el valor 2: ";
	Leer valor2;
	
	//Procesos
	suma = valor1 + valor2;
	producto = valor1 * valor2;
	div = valor1 / valor2;
	
	//Salida
	Escribir  "El resultado de la suma es: ",suma;
	Escribir  "El resultado del producto es: ",producto;
	Escribir  "El resultado de la divición es: ",div;
	
FinAlgoritmo
