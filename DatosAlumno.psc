Algoritmo DatosAlumno
	// se solicitaran los datos del alumno
	Definir Nombre, Apellido, Carrera como caracter;
	Definir Matricula, Cuatrimestre, Grupo como entero;
	Escribir "ingresa tu nombre";
	Leer Nombre;
	Escribir "ingresa tu apellido";
	Leer Apellido;
	Escribir "Cual es tu carrera";
	Leer Carrera;
	Escribir "cual es tu matricula";
	Leer Matricula;
	Escribir "ingresa tu cuatrimestre";
	Leer Cuatrimestre;
	Escribir "Cual es tu grupo";
	Leer Grupo;
	Escribir "----Tus datos son----" ;
	Escribir "Nombre: ", Nombre;
	Escribir "Apellido: ", Apellido;
	Escribir "Carrera: ", Carrera;
	Escribir "Matricula: ", matricula;
	Escribir "Cuatrimestre: ", Cuatrimestre;
	Escribir "Grupo: ", Grupo;
FinAlgoritmo
